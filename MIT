## 📁 `1-straitsx-dva/gateway.js`

```javascript
const express = require('express');
const cors = require('cors');
const axios = require('axios');
const { Connection, PublicKey, Transaction } = require('@solana/web3.js');
const { getAssociatedTokenAddress, createTransferInstruction } = require('@solana/spl-token');
const { Keypair } = require('@solana/web3.js');
const bs58 = require('bs58');
const xml2js = require('xml2js');
require('dotenv').config();

const app = express();
app.use(cors());
app.use(express.json({ limit: '10mb' }));
app.use(express.text({ type: 'application/xml', limit: '10mb' }));

// ============ КОНФИГУРАЦИЯ ============
const PORT = process.env.PORT || 3000;
const MASTER_WALLET = new PublicKey(process.env.MASTER_WALLET);

// Solana connection
const connection = new Connection(process.env.SOLANA_RPC_URL, 'confirmed');
const USDC_MINT = new PublicKey(process.env.USDC_MINT);

// Master wallet (отправитель USDC)
const privateKeyBytes = bs58.decode(process.env.PRIVATE_KEY);
const masterWallet = Keypair.fromSecretKey(privateKeyBytes);

// StraitsX API
const STRAITSX_API = axios.create({
  baseURL: 'https://api.straitsx.com/v1',
  headers: {
    'X-API-Key': process.env.STRAITSX_API_KEY,
    'X-API-Secret': process.env.STRAITSX_API_SECRET
  }
});

// ============ ПАРСЕР SWIFT ============
async function parsePacs008(xml) {
  try {
    const parser = new xml2js.Parser({ explicitArray: false });
    const result = await parser.parseStringPromise(xml);
    
    const doc = result['Document'];
    const pmtInf = doc['FIToFICstmrCdtTrf']['CdtTrfTxInf'][0] || 
                   doc['FIToFICstmrCdtTrf']['CdtTrfTxInf'];
    
    const amount = parseFloat(pmtInf['Amt']['InstdAmt']['_'] || pmtInf['Amt']['InstdAmt']);
    const currency = pmtInf['Amt']['InstdAmt']['$']['Ccy'] || 'USD';
    const debtor = pmtInf['Dbtr']['Nm'] || 'Unknown';
    const creditor = pmtInf['Cdtr']['Nm'] || 'Unknown';
    const reference = pmtInf['PmtId']['EndToEndId'] || 'N/A';
    const creditorAddress = pmtInf['CdtrAcct']?.['Id']?.['Othr']?.['Id'] || null;
    
    return { amount, currency, debtor, creditor, reference, creditorAddress };
  } catch (error) {
    throw new Error(`Invalid ISO 20022: ${error.message}`);
  }
}

// ============ ОТПРАВКА USDC ============
async function sendUSDC(toAddress, amount) {
  try {
    const toPubkey = new PublicKey(toAddress);
    const fromTokenAccount = await getAssociatedTokenAddress(USDC_MINT, masterWallet.publicKey);
    const toTokenAccount = await getAssociatedTokenAddress(USDC_MINT, toPubkey);
    
    const amountLamports = Math.floor(amount * 1_000_000);
    
    const transferInstruction = createTransferInstruction(
      fromTokenAccount,
      toTokenAccount,
      masterWallet.publicKey,
      amountLamports,
      []
    );
    
    const transaction = new Transaction().add(transferInstruction);
    transaction.feePayer = masterWallet.publicKey;
    
    const signature = await connection.sendTransaction(transaction, [masterWallet]);
    await connection.confirmTransaction(signature, 'confirmed');
    
    return signature;
  } catch (error) {
    throw new Error(`Solana error: ${error.message}`);
  }
}

// ============ КОНВЕРТАЦИЯ XUSD → USDC ============
async function convertXUSDtoUSDC(xusdAmount) {
  try {
    // Запрос к StraitsX на конвертацию XUSD в USDC
    const response = await STRAITSX_API.post('/convert', {
      from: 'XUSD',
      to: 'USDC',
      amount: xusdAmount,
      network: 'SOLANA'
    });
    return response.data;
  } catch (error) {
    throw new Error(`StraitsX conversion error: ${error.message}`);
  }
}

// ============ ENDPOINTS ============

// 🏦 Прием SWIFT XML
app.post('/api/swift', async (req, res) => {
  try {
    const xml = req.body;
    if (!xml || typeof xml !== 'string') {
      return res.status(400).json({ error: 'Invalid XML payload' });
    }
    
    const parsed = await parsePacs008(xml);
    console.log('📥 SWIFT received:', parsed);
    
    if (!parsed.creditorAddress) {
      return res.status(400).json({
        error: 'Missing Solana address in SWIFT',
        hint: 'Add <CdtrAcct><Id><Othr><Id>SOLANA_ADDRESS</Id></Othr></Id></CdtrAcct>'
      });
    }
    
    // Конвертируем XUSD в USDC через StraitsX
    // В реальности нужно дождаться поступления XUSD на DVA счет
    const conversionResult = await convertXUSDtoUSDC(parsed.amount);
    console.log('💱 Converted XUSD → USDC:', conversionResult);
    
    // Отправляем USDC получателю
    const fee = parsed.amount * 0.01; // 1% комиссия
    const sendAmount = parsed.amount - fee;
    
    const signature = await sendUSDC(parsed.creditorAddress, sendAmount);
    console.log('✅ USDC sent:', signature);
    
    res.status(200).json({
      status: 'ACCEPTED',
      transactionId: signature,
      from: MASTER_WALLET.toBase58(),
      to: parsed.creditorAddress,
      amount: sendAmount,
      fee: fee,
      currency: 'USDC',
      reference: parsed.reference,
      timestamp: new Date().toISOString()
    });
  } catch (error) {
    console.error('❌ Error:', error.message);
    res.status(500).json({ error: error.message });
  }
});

// 📌 Webhook от StraitsX (при поступлении XUSD на DVA)
app.post('/api/webhook/straitsx', async (req, res) => {
  try {
    const { amount, currency, reference, solanaAddress } = req.body;
    console.log('💰 StraitsX payment received:', { amount, currency, reference });
    
    // Конвертируем XUSD в USDC (если еще не конвертировали)
    const conversionResult = await convertXUSDtoUSDC(amount);
    
    // Отправляем USDC получателю
    const fee = amount * 0.01;
    const sendAmount = amount - fee;
    
    const signature = await sendUSDC(solanaAddress, sendAmount);
    console.log('✅ USDC sent via webhook:', signature);
    
    res.status(200).json({
      success: true,
      transactionId: signature,
      amount: sendAmount,
      fee: fee
    });
  } catch (error) {
    console.error('❌ Webhook error:', error.message);
    res.status(500).json({ error: error.message });
  }
});

// 🩺 Health check
app.get('/health', (req, res) => {
  res.json({
    status: 'ok',
    provider: 'StraitsX DVA',
    masterWallet: MASTER_WALLET.toBase58()
  });
});

app.listen(PORT, () => {
  console.log(`🚀 StraitsX DVA Gateway running on http://localhost:${PORT}`);
  console.log(`💰 Master wallet: ${MASTER_WALLET.toBase58()}`);
});
